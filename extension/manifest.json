{
  "manifest_version": 3,
  "name": "Job Radar: в пул",
  "version": "0.1.0",
  "description": "Собирает ссылки на вакансии с открытой страницы списка и отправляет в локальный jr serve на оценку.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Radar: оценить вакансии со страницы"
  }
}
